DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5433/ty

# --- required everywhere (use long random strings; keep ENCRYPTION_KEY safe) ---
SECRET_KEY=change-me-to-a-long-random-string-32+chars
ENCRYPTION_KEY=another-long-random-string

# --- optional ---
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Frontend origins allowed to call the API, comma-separated (scheme://host:port), or * for any
CORS_ORIGINS=*
